# fake: deterministic demo; local: real local models with Slack-free test APIs; live: Slack runtime
APP_MODE=fake
LOG_LEVEL=INFO

# Slack (Socket Mode)
SLACK_ENABLED=false
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Bot joins newly created public channels by itself (needs channels:join + channels:read scopes)
SLACK_AUTO_JOIN=true

# LM Studio (native on host, OpenAI-compatible endpoint). This deployment is
# intentionally limited to the 7B model; local/live startup rejects 27B IDs.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=qwen/qwen2.5-vl-7b
LM_STUDIO_API_KEY=lm-studio
NANOBOT_URL=http://nanobot:8090
NANOBOT_TIMEOUT_SECONDS=150
# Must match the context length actually loaded in LM Studio (its "Context
# Length" setting for the loaded model), not the model's max supported size -
# otherwise nanobot's own agent prompts silently overflow and every research
# call falls back to plain DuckDuckGo instead of nanobot's real reasoning.
NANOBOT_CONTEXT_TOKENS=16384
NANOBOT_MAX_OUTPUT_TOKENS=1024
# How long the backend lets nanobot's own agent subprocess run before killing
# it and falling back to plain DuckDuckGo search. Must stay comfortably below
# NANOBOT_TIMEOUT_SECONDS above (the outer HTTP call budget). On slower/GPU-
# constrained hardware a real nanobot research call can take 30-60s+.
NANOBOT_AGENT_TIMEOUT_SECONDS=100

# Postgres + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=teaching_ai_agents
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/teaching_ai_agents

# HumanReview auto-approve threshold (0-100, computed risk_score; see
# docs/project-architecture-plan.md section 3)
RISK_THRESHOLD=50
MATERIALITY_THRESHOLD=10000000
MAX_REVISIONS=2
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RETRIEVAL_LIMIT=12
FRONTEND_ORIGIN=http://localhost:3000
DOCUMENT_STORE=/data/documents
GUIDEBOOK_DIR=/data/guidebooks

# NOTE: ALWAYS_REVIEW is not an env var - it's a live-reloadable row in the
# Postgres `app_settings` table so it can be flipped without a restart
# (see docs/project-architecture-plan.md sections 3-4).
