# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# LM Studio (native on host, OpenAI-compatible endpoint)
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# Postgres + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=teaching_ai_agents
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/teaching_ai_agents

# HumanReview auto-approve threshold (0-100, computed risk_score; see
# docs/project-architecture-plan.md section 3)
RISK_THRESHOLD=50

# NOTE: ALWAYS_REVIEW is not an env var - it's a live-reloadable row in the
# Postgres `app_settings` table so it can be flipped without a restart
# (see docs/project-architecture-plan.md sections 3-4).
